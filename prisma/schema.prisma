generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("user")
  createdAt DateTime @default(now())
}

model Tenant {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  industry    String
  tagline     String
  description String
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agent         AgentConfig?
  handoffRules  HandoffRule[]
  knowledgeDocs KnowledgeDoc[]
  conversations Conversation[]
  leads         Lead[]
  meetings      Meeting[]
  callLogs      CallLog[]
  usageLogs     UsageLog[]
  voiceSessions VoiceSession[]
  handoffs      Handoff[]
}

model AgentConfig {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  tone                String
  description         String
  targetTitles        String
  qualificationRounds Int      @default(3)
  collectName         Boolean  @default(true)
  collectCompany      Boolean  @default(true)
  collectEmail        Boolean  @default(true)
  emailRequiredOnChat Boolean  @default(false)
  voiceId             String   @default("shimmer")
  greeting            String
  shortReplies        Boolean  @default(true)
  humanizedTone       Boolean  @default(true)
  interruptionEnabled Boolean  @default(true)
  autoPauseEnabled    Boolean  @default(true)
  noiseCancelEnabled  Boolean  @default(true)
  lowLatencyMode      Boolean  @default(true)
  vadSilenceMs        Int      @default(300)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model HandoffRule {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  triggers    String
  action      String
  transferTo  String?
  enabled     Boolean @default(true)
  description String
  sortOrder   Int     @default(0)

  @@index([tenantId])
}

model KnowledgeDoc {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  content   String
  chunks    String
  size      Int
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Conversation {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel         String    @default("chat")
  status          String    @default("active")
  offTopicStrikes Int       @default(0)
  leadId          String?
  lead            Lead?     @relation(fields: [leadId], references: [id])
  messages        Message[]
  handoffs        Handoff[]
  callLogs        CallLog[]
  sessions        VoiceSession[]
  summary         String?
  tokensIn        Int       @default(0)
  tokensOut       Int       @default(0)
  tokensUsed      Int       @default(0)
  costUsd         Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime     @default(now())
}

model Lead {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String?
  email         String?
  company       String?
  title         String?
  persona       String?
  phone         String?
  status        String         @default("new")
  notes         String?
  source        String         @default("chat")
  askCount      Int            @default(0)
  conversations Conversation[]
  meetings      Meeting[]
  handoffs      Handoff[]
  callLogs      CallLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
}

model Handoff {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id])
  reason         String
  details        String
  status         String        @default("pending")
  transferTo     String?
  createdAt      DateTime      @default(now())

  @@index([tenantId])
}

model Meeting {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id])
  title       String
  reason      String
  scheduledAt DateTime
  durationMin Int      @default(30)
  status      String   @default("scheduled")
  notes       String?
  meetLink    String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model UsageLog {
  id             String   @id @default(cuid())
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  type           String
  model          String
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  characters     Int      @default(0)
  costUsd        Float
  conversationId String?
  createdAt      DateTime @default(now())

  @@index([tenantId])
}

model CallLog {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  direction      String
  status         String        @default("ringing")
  outcome        String        @default("unknown")
  duration       Int           @default(0)
  phoneNumber    String?
  contactName    String?
  roomName       String?
  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id])
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  tokensIn       Int           @default(0)
  tokensOut      Int           @default(0)
  costUsd        Float         @default(0)
  notes          String?
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime      @default(now())

  @@index([tenantId])
}

model VoiceSession {
  id             String        @id @default(cuid())
  tenantId       String?
  tenant         Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  mode           String        @default("desktop")
  status         String        @default("active")
  roomName       String?
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  interruption   Boolean       @default(true)
  noiseCancel    Boolean       @default(true)
  autoPause      Boolean       @default(true)
  lowLatency     Boolean       @default(true)
  tokensIn       Int           @default(0)
  tokensOut      Int           @default(0)
  createdAt      DateTime      @default(now())
  endedAt        DateTime?
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
