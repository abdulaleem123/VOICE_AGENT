# =============================================================================
# Voice Agent — copy this file to `.env` and fill in your values.
# NEVER commit `.env` to git.
# =============================================================================

# --- OpenAI (required) ---
# Chat, embeddings, Whisper STT, TTS, and desktop Realtime voice.
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_SPEED=1.08
OPENAI_STT_MODEL=whisper-1
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=shimmer

# --- Database (multi-tenant SQLite; use Postgres URL in real production) ---
DATABASE_URL="file:./dev.db"
# Optional: force seed skip during prod-setup (default seeds 5 industries)
# SEED_ON_SETUP=1

# --- Auth (required) ---
# Use a long random string — at least 32 characters.
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# --- Operator login → http://localhost:4000/login ---
USER_EMAIL=operator@voiceagent.local
USER_PASSWORD=Operator123!
USER_NAME=Operator

# --- Super admin → http://localhost:4000/admin/login ---
SUPER_ADMIN_EMAIL=admin@voiceagent.local
SUPER_ADMIN_PASSWORD=Admin123!
SUPER_ADMIN_NAME=Super Admin

# --- App URL (used for CSRF / origin checks) ---
APP_URL=http://localhost:4000

# --- Desktop / LiveKit voice worker (inbound + outbound) ---
# Merged from conversational_ai_Agent — fill when you have LiveKit + SIP.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
INBOUND_TRUNK_ID=
OUTBOUND_TRUNK_ID=
TELNYX_PHONE_NUMBER=
AGENT_NAME=voice-agent-desktop
DESKTOP_WORKER_KEY=desktop-dev-key
DISPATCH_API_URL=http://localhost:8000
LOG_LEVEL=INFO
# Which industry pack the LiveKit worker loads (hospital|restaurant|supermart|estate-agency|software-house)
TENANT_SLUG=hospital
